#!/bin/bash
# 卸载后：按用户在卸载向导中的选择决定是否删除应用数据
set -u

AMANE_SCRIPT_TAG=uninstall_callback

_lib_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
for _candidate in "$_lib_dir" "${TRIM_APPDEST:-}/../cmd" "/var/apps/${TRIM_APPNAME:-amane}/cmd"; do
    if [ -n "$_candidate" ] && [ -r "$_candidate/lib/common.sh" ]; then
        # shellcheck source=lib/common.sh
        . "$_candidate/lib/common.sh"
        break
    fi
done

_remove="${wizard_remove_data:-false}"
case "$_remove" in
true | True | TRUE | 1 | yes | on) _remove=1 ;;
*) _remove=0 ;;
esac

if [ "$_remove" -ne 1 ]; then
    amane_log "按用户选择保留应用数据目录"
    exit 0
fi

_data_dir=""
if [ -r "${AMANE_CMD_DIR:-}/lib/compose.sh" ]; then
    # shellcheck source=lib/compose.sh
    . "${AMANE_CMD_DIR}/lib/compose.sh"
    _data_dir=$(amane_resolve_data_dir)
fi

# 只允许删除 fnOS 应用共享目录（@appshare）下的数据，绝不触碰其他路径
case "$_data_dir" in
/vol*/@appshare/*)
    if [ -d "$_data_dir" ]; then
        if rm -rf -- "$_data_dir" 2>/dev/null; then
            amane_log "已删除应用数据目录 ${_data_dir}"
            rmdir -- "$(dirname "$_data_dir")" 2>/dev/null || true
        else
            amane_log "删除 ${_data_dir} 失败，请手动检查"
        fi
    fi
    ;;
*)
    amane_log "拒绝删除非应用共享目录：${_data_dir:-<未知>}"
    ;;
esac

exit 0
